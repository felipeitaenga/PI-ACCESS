      "hierarchy_tree": "grid grid-cols-1 lg:grid-cols-3 gap-6"
    }
  },
  "component_guidelines": {
    "dashboard_kpis": "Dense high-contrast metric cards with status indicator LED dots, subtle 1px border hover glow, micro sparklines or change percentages.",
    "live_event_feed": "Real-time ticker stream with WebSocket integration. Color-coded event rows (Green = Liberado, Red = Negado, Amber = Alerta/Forçada). Interactive row click opens modal or inspector drawer.",
    "facial_verification": "Side-by-side photo visualizer: 'Foto Cadastrada' vs 'Foto Capturada' with AI confidence match gauge percentage (e.g., 98.4% Match).",
    "remote_door_unlock": "Primary action button with safety confirmation dialog / holding state ('Confirmação de Abertura Remota' to prevent accidental unlocks).",
    "hierarchy_tree": "Interactive accordion / tree view displaying Sites > Áreas > Portas > Dispositivos with online status badges and door lock states.",
    "emergency_incident_mode": "Prominent red alert banner / trigger button for 'PÂNICO / INCÊNDIO / LOCKDOWN GENERAL' with multi-step confirmation toast.",
    "recharts": "Custom dark tooltips, semi-transparent gradient area charts, custom legend with pt-BR labels, non-overlapping responsive container."
  },
